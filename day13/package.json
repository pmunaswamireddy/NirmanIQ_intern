{
  "name": "day13-nestjs-typeorm-postgres",
  "version": "1.0.0",
  "description": "NirmanIQ Day 13 - PostgreSQL & TypeORM with NestJS",
  "author": "Penumuru Madhu Sudhan Reddy",
  "private": true,
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc",
    "start": "node dist/main.js",
    "test": "node test-day13.cjs",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
